FROM python:3.12-slim

# ffmpeg/ffprobe: media preprocessing. ca-certificates: Tiger Postgres uses sslmode=verify-full.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Every module imports through the `backend.` package, and main.py puts its parent
# directory on sys.path, so the service root must live at /app/backend.
WORKDIR /app/backend

COPY requirements.txt requirements-specialist.txt requirements-whisper.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Ship the chosen ASR and model with the backend; no runtime model download.
# Opt out only when deploying with TRANSCRIPTION_PROVIDER=gemini.
ARG INSTALL_WHISPER=1
RUN if [ "$INSTALL_WHISPER" = "1" ]; then pip install --no-cache-dir -r requirements-whisper.txt; fi

ARG WHISPER_BUILD_MODEL=small.en
RUN if [ "$INSTALL_WHISPER" = "1" ]; then python -c "from faster_whisper.utils import download_model; download_model('$WHISPER_BUILD_MODEL', output_dir='/opt/quantro/whisper')"; fi
ENV WHISPER_MODEL=/opt/quantro/whisper

COPY . .

ENV PYTHONUNBUFFERED=1
# Hosts pass the listen port in $PORT (Render sets it; Vercel defaults to 80).
EXPOSE 80
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-80}"]
