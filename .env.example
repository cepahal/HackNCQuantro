# Template only. Copy to .secrets/.env (git-ignored), fill in there, and link it:
#   mkdir -p .secrets && cp .env.example .secrets/.env && ln -s .secrets/.env .env.local
# Never put real values in a tracked file.

# ===== REPORT / DELIVERY (Bhrigu) =====
REPORT_BASE_URL=http://localhost:3000
REPORT_STORE=tiger
# Optional browser CORS origin; blank falls back to REPORT_BASE_URL.
FRONTEND_ORIGIN=

# ===== TIGER DATA =====
TIGER_DATABASE_URL=
TIGER_TABLE_PREFIX=quantro_
# Retrieval media store + search corpus (Abdullah); same Tiger service.
TIGERDATA_DSN=
TIGERDATA_SSL_ROOT_CERT=system

# ===== MESSAGING: Photon Spectrum (server-only) =====
# Opt in to running the existing Spectrum listener beside the hosted API.
PHOTON_ENABLED=false
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Private token for the local HTTP bridge; generate with Node crypto.randomBytes(32).
PHOTON_BRIDGE_TOKEN=
PHOTON_BRIDGE_PORT=8766
PHOTON_DATA_DIR=.data/photon
# Photon HTTP webhook (POST /webhooks/photon); get from Photon
PHOTON_API_KEY=
PHOTON_BASE_URL=
PHOTON_SENDER_ID=
# Optional read-only sharing gateway allowlist; blank keeps sharing disabled.
PHOTON_PUBLIC_REPORTS_FILE=

# ===== ACTIVE RESOLVER: Exa search + Gemini explanations + timed captions =====
SEARCH_PROVIDER=exa
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Groq browser search is no longer used by the active resolver.
GROQ_SOURCE_SEARCH=false
# Optional official YouTube Data API. Blank uses yt-dlp search without a new key.
YOUTUBE_API_KEY=
# Timed captions are used first; missing captions fall back to Groq Whisper.
GROQ_MAX_UPLOAD_MB=25
# YouTube embeds do not need a local MP4. Opt in only when a downloaded copy is needed.
RESOLUTION_DOWNLOAD_VIDEO=false

# Exa supplies bounded public recording leads; timed speech must still align.
EXA_API_KEY=
# Optional one-query lexical supplement for remote YouTube source discovery.
SEARCH_FALLBACK_PROVIDER=
SEARCH_FALLBACK_API_KEY=
# Existing provider key is used when SEARCH_FALLBACK_API_KEY is blank.
SEARCH_PROVIDER_API_KEY=

# Gemini explains submitted and matched source transcripts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Select comparison separately; this model passed the local access probe.
GEMINI_COMPARISON_MODEL=gemini-3.1-flash-lite
# One brief text interpretation, including when no source is found.
SUBMITTED_INTERPRETATION_ENABLED=true
# whisper (local faster-whisper; production) or gemini
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL=small.en
# Optional directory containing ffmpeg and ffprobe; startup requires both tools.
MEDIA_TOOLS_DIR=

# ===== FRONTEND (Grant) =====
# In Vercel, set this to the deployed backend URL; localhost is only for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional read-only report/media gateway; blank reuses the analysis API base.
NEXT_PUBLIC_REPORT_API_BASE_URL=
NEXT_PUBLIC_REPORT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PHOTON_NUMBER=

# Google CSE engine ID (public-web discovery).
SEARCH_GOOGLE_CSE_ID=

# Inactive running jobs expire on status checks; worker stages refresh updated_at.
ANALYSIS_STALE_SECONDS=900

# Optional archived AdvancedKit HTTP bridge only; separate from send API and Spectrum.
PHOTON_WEBHOOK_SECRET=

# Sentence-based original-source excerpt with on-video context labels.
# Failure leaves the existing report/source available. Disable to skip rendering.
CONTEXT_VIDEO_ENABLED=true
