{
  "name": "quantro-photon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-system-ca --env-file-if-exists=../../../.env src/index.ts",
    "start:imessage": "node --use-system-ca --env-file-if-exists=../../../.env src/index.ts --imessage",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "engines": { "node": ">=24" },
  "dependencies": { "spectrum-ts": "12.10.1" },
  "devDependencies": { "@types/node": "26.6.5", "typescript": "6.0.3" },
  "overrides": { "@opentelemetry/core": "2.12.0" }
}
